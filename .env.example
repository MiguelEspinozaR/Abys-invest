# Template de entorno local — copia a .env y ajusta los valores.
# NUNCA se commitean valores reales: estos son placeholders de desarrollo local.

# PostgreSQL (instancia dedicada de Abys, puerto 55432)
POSTGRES_USER=abys
POSTGRES_PASSWORD=abys
POSTGRES_DB=abys

# Conexión usada por api/collector/analytics/tests (la BD real de Abys-Invest
# es la instancia abys-postgres 55432; el puerto 5432 pertenece al cluster
# del sistema y NO contiene el esquema de Abys-Invest)
DATABASE_URL=postgres://abys:abys@localhost:55432/abys?sslmode=disable

# BD dedicada SOLO para la suite de integración (nunca toca la de datos;
# el target integration exige una BD *_test, ver Makefile)
TEST_DATABASE_URL=postgres://abys:abys@localhost:55432/abys_test?sslmode=disable

# User-Agent identificativo exigido por la política de SEC EDGAR
SEC_EDGAR_USER_AGENT=AbysInvest/1.0 (contact@abys-invest.dev)

# API key opcional de BLS (25 queries/día sin key; suficiente para el batch diario)
BLS_API_KEY=

# Tasa de crecimiento g por defecto para PEG, Graham y DCF (%), §13
# M6a: valor de respaldo (fallback) cuando el Growth Engine no tiene datos
# suficientes. El motor individual ya persiste su propia tasa en growth_metrics.
GROWTH_RATE_DEFAULT=7

# Motor de crecimiento por security (M6a). Todos los rates en PORCENTAJE.
# El clamp [GROWTH_MIN_RATE, GROWTH_MAX_RATE] se aplica a la tasa normalizada y
# se marca growth_clamped en la fila.
GROWTH_WINDOW_PRIMARY_YEARS=3
GROWTH_WINDOW_FALLBACK_YEARS=5
# Duración de un año fiscal en días (52/53-semanas ≠ 365 exactos): filtro SQL (D2)
GROWTH_ANNUAL_MIN_DAYS=330
GROWTH_ANNUAL_MAX_DAYS=400
# Pesos del blend EPS/FCF (se renormalizan si falta uno de los dos)
GROWTH_EPS_WEIGHT=0.5
GROWTH_FCF_WEIGHT=0.5
# Umbral de discrepancia revenue vs EPS/FCF que marca revenue_discrepancy (pp)
GROWTH_DISCREPANCY_PP=10
GROWTH_MIN_RATE=-10
GROWTH_MAX_RATE=25

# WACC CAPM por security (M6a). Todos los rates en PORCENTAJE.
WACC_RISK_FREE_RATE=4.5
WACC_EQUITY_RISK_PREMIUM=5.5
# Kd pre-tax y tasa fiscal recortada a [0, 50]
WACC_COST_OF_DEBT=6.0
WACC_TAX_RATE=21
# Beta asumida SOLO si el security no tiene beta observada de Yahoo
# (wacc_source = configured_fallback); si hay beta de Yahoo, manda la observada.
WACC_BETA_ASSUMED=1.0
# WACC global de fallback; <= 0 → nil en vez de inventar
WACC_FALLBACK=9.0

# Parámetros de valoración DCF (mixture: WACC, proyección, crecimiento terminal)
# M6a: DCF_DISCOUNT_RATE SIGUE siendo el WACC del DCF (10). El WACC individual
# por security ya se persiste en wacc_metrics; cablearlo aquí es de M6b.
DCF_DISCOUNT_RATE=10
DCF_HORIZON_YEARS=5
DCF_TERMINAL_GROWTH=2.5

# Score engine: margen de seguridad y comparables (SPEC §13.5)
MARGIN_OF_SAFETY=30
COMPARABLES_MIN_SECURITIES=5
COMPARABLES_HISTORY_YEARS=5

# Puerto del binario api
API_PORT=8080