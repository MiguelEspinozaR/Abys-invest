# Template de entorno local — copia a .env y ajusta los valores.
# NUNCA se commitean valores reales: estos son placeholders de desarrollo local.

# PostgreSQL (instancia dedicada de Abys, puerto 55432)
POSTGRES_USER=abys
POSTGRES_PASSWORD=abys
POSTGRES_DB=abys

# Conexión usada por api/collector/analytics/tests (la BD real de Abys-Invest
# es la instancia abys-postgres 55432; el puerto 5432 pertenece al cluster
# del sistema y NO contiene el esquema de Abys-Invest)
DATABASE_URL=postgres://abys:abys@localhost:55432/abys?sslmode=disable

# BD dedicada SOLO para la suite de integración (nunca toca la de datos;
# el target integration exige una BD *_test, ver Makefile)
TEST_DATABASE_URL=postgres://abys:abys@localhost:55432/abys_test?sslmode=disable

# User-Agent identificativo exigido por la política de SEC EDGAR
SEC_EDGAR_USER_AGENT=AbysInvest/1.0 (contact@abys-invest.dev)

# API key opcional de BLS (25 queries/día sin key; suficiente para el batch diario)
BLS_API_KEY=

# Tasa de crecimiento g por defecto para PEG, Graham y DCF (%), §13
GROWTH_RATE_DEFAULT=7

# Parámetros de valoración DCF (mixture: WACC, proyección, crecimiento terminal)
DCF_DISCOUNT_RATE=10
DCF_HORIZON_YEARS=5
DCF_TERMINAL_GROWTH=2.5

# Score engine: margen de seguridad y comparables (SPEC §13.5)
MARGIN_OF_SAFETY=30
COMPARABLES_MIN_SECURITIES=5
COMPARABLES_HISTORY_YEARS=5

# Puerto del binario api
API_PORT=8080